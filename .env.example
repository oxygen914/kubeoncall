# KubeOnCall Docker Compose configuration
# Copy this file to .env, replace every CHANGE_ME/YOUR_* value, then run:
#   docker compose config --quiet

# Network bindings. Keep 127.0.0.1 when using an SSH tunnel or reverse proxy.
KUBEONCALL_BIND_ADDRESS=127.0.0.1
CONSOLE_BIND_ADDRESS=127.0.0.1
CONSOLE_PORT=8081
INFRA_BIND_ADDRESS=127.0.0.1
OBSERVABILITY_BIND_ADDRESS=127.0.0.1

# Aliyun DashScope / Bailian OpenAI-compatible models.
ALIYUN_API_KEY=YOUR_ALIYUN_API_KEY
SPRING_AI_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=qwen-plus
# KubeOnCall wires the Planner client explicitly, so the global Spring AI auto-configuration stays
# excluded. Never commit a real key or render `docker compose config` into build artifacts/logs.
SPRING_AUTOCONFIGURE_EXCLUDE=org.springframework.ai.autoconfigure.openai.OpenAiAutoConfiguration
SPRING_AI_OPENAI_CHAT_ENABLED=false
SPRING_AI_OPENAI_EMBEDDING_ENABLED=false
SPRING_AI_OPENAI_IMAGE_ENABLED=false
SPRING_AI_OPENAI_AUDIO_TRANSCRIPTION_ENABLED=false
SPRING_AI_OPENAI_AUDIO_SPEECH_ENABLED=false
KUBEONCALL_PLANNER_MODE=REAL_MODEL
KUBEONCALL_PLANNER_PROVIDER=aliyun-dashscope
KUBEONCALL_PLANNER_MODEL=qwen-plus
KUBEONCALL_PLANNER_CONNECT_TIMEOUT_MILLIS=3000
KUBEONCALL_PLANNER_READ_TIMEOUT_MILLIS=30000
# A canary performs one real structured Planner call at startup. Fail-fast prevents a deployment
# with an invalid key, unavailable model or incompatible response schema from advertising AI.
KUBEONCALL_PLANNER_CANARY_ENABLED=true
KUBEONCALL_PLANNER_CANARY_FAIL_FAST=true

# Unified evidence collection remains fail-closed until both feature and scope allowlists are set.
KUBEONCALL_EVIDENCE_PROMETHEUS_ENABLED=false
KUBEONCALL_EVIDENCE_LOKI_ENABLED=false
KUBEONCALL_EVIDENCE_K8S_EVENTS_ENABLED=false
KUBEONCALL_EVIDENCE_POD_LOGS_ENABLED=false
KUBEONCALL_EVIDENCE_ALLOWED_CLUSTERS=
KUBEONCALL_EVIDENCE_ALLOWED_NAMESPACES=

# API role tokens. Generate independent values with: openssl rand -hex 32
KUBEONCALL_API_AUTH_ENABLED=true
KUBEONCALL_API_VIEWER_TOKEN=CHANGE_ME_VIEWER_TOKEN
KUBEONCALL_API_OPERATOR_TOKEN=CHANGE_ME_OPERATOR_TOKEN
KUBEONCALL_API_ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN

# Browser origins allowed to call the backend directly.
KUBEONCALL_CORS_ENABLED=true
KUBEONCALL_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081
KUBEONCALL_DEPENDENCY_CIRCUIT_BREAKER_ENABLED=true
KUBEONCALL_DEPENDENCY_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
KUBEONCALL_DEPENDENCY_CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=30

# MinIO. These values configure both the server and KubeOnCall client.
MINIO_ROOT_USER=kubeoncall
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=kubeoncall-docs

# Alertmanager. The same token must also be written to
# deploy/alertmanager/secrets/kubeoncall-webhook-token.
ALERTMANAGER_WEBHOOK_TOKEN=CHANGE_ME_ALERTMANAGER_TOKEN

# Grafana.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# RAG defaults. Embedding and rerank use ALIYUN_API_KEY.
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSIONS=1536
RAG_RERANK_MODEL=qwen3-rerank
RAG_AUGMENTATION_ENABLED=false
RAG_AUTO_BIND_DATASET_VERSION=false

# Memory model calls are opt-in.
MEMORY_LLM_EXTRACTION_ENABLED=false
MEMORY_SEMANTIC_DUPLICATE_ENABLED=false
MEMORY_TOKENIZER_ENABLED=false

# MCP is disabled until a reachable endpoint and authentication are configured.
MCP_ENABLED=false
MCP_DISCOVERY_ENABLED=false
MCP_DYNAMIC_INVOCATION_ENABLED=false
MCP_ENDPOINT=http://host.docker.internal:18080/mcp/call
MCP_AUTH_MODE=static_bearer
MCP_API_KEY=

# Change-event webhooks are opt-in.
CHANGE_EVENT_WEBHOOK_ENABLED=false
CHANGE_EVENT_WEBHOOK_AUTH_MODE=bearer
CHANGE_EVENT_WEBHOOK_TOKEN=

# Optional external notification/incident adapters.
ALERT_NOTIFICATION_WEBHOOK_ENDPOINT=
INCIDENT_TOOL_ENDPOINT=http://host.docker.internal:18087/api/tools/incident

# MySQL business fact store and identity/RBAC. Set SPRING_PROFILES_ACTIVE to include "mysql"
# (e.g. docker,mysql) to enable Flyway and the /api/v1 auth surface.
MYSQL_DATABASE=kubeoncall
MYSQL_USER=kubeoncall
MYSQL_PASSWORD=CHANGE_ME
MYSQL_MIGRATION_USER=kubeoncall_migration
MYSQL_MIGRATION_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/kubeoncall?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=kubeoncall
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
KUBEONCALL_AUTH_SESSION_COOKIE_SECURE=false
KUBEONCALL_AUTH_SESSION_IDLE_TIMEOUT_SECONDS=1800
KUBEONCALL_AUTH_SESSION_MAX_TIMEOUT_SECONDS=28800
KUBEONCALL_AUTH_LOGIN_MAX_ATTEMPTS=5
KUBEONCALL_AUTH_LOGIN_LOCK_DURATION_SECONDS=900

# One-time initial administrator bootstrap. After the admin is created, set this back to false and
# remove the username/password variables. Never leave these set in production.
KUBEONCALL_BOOTSTRAP_ADMIN_ENABLED=false
KUBEONCALL_BOOTSTRAP_ADMIN_USERNAME=
KUBEONCALL_BOOTSTRAP_ADMIN_PASSWORD=

# WBS-11 data migration & legacy API retirement.
# alarm-read-source: MYSQL (default) | REDIS | SHADOW (read MySQL, also read Redis and record diffs).
KUBEONCALL_DATA_MIGRATION_ALARM_READ_SOURCE=MYSQL
KUBEONCALL_DATA_MIGRATION_BACKFILL_BATCH_SIZE=100
KUBEONCALL_DATA_MIGRATION_BACKFILL_SCAN_LIMIT=10000
KUBEONCALL_DATA_MIGRATION_BACKFILL_MAX_ITEMS_PER_SECOND=100
KUBEONCALL_DATA_MIGRATION_BACKFILL_TASK_TIMEOUT_SECONDS=1800
KUBEONCALL_DATA_MIGRATION_BACKFILL_DRY_RUN=true
KUBEONCALL_DATA_MIGRATION_SHADOW_DIFF_THRESHOLD_PERCENT=1.0
# Optional explicit legacy actor to local username mappings for Ack/Silence/Recovery apply.
# Comma-separated, for example: system=migration-system,incident-commander=oncall-admin
KUBEONCALL_DATA_MIGRATION_LEGACY_ACTOR_USERNAME_MAPPINGS=
# Set to false to retire the legacy /api/* surface (v1 stays up). Config-only rollback.
KUBEONCALL_LEGACY_API_ENABLED=true
