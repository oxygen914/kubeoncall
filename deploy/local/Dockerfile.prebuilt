# syntax=docker/dockerfile:1.7
FROM eclipse-temurin:17-jre@sha256:92999aea37688157a53a40bfcb187c30f317422e028045fd5fc5c548fde9e626
WORKDIR /app
RUN useradd --system --uid 10001 kubeoncall
# CI copies the versioned Maven result to this stable name after tests pass. Packaging the exact
# tested artifact avoids downloading the complete Maven graph again inside Docker.
COPY backend/target/kubeoncall.jar /app/kubeoncall.jar
USER 10001
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/kubeoncall.jar"]
