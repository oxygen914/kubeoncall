{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "KubeOnCall Helm values",
  "type": "object",
  "required": [
    "replicaCount",
    "image",
    "config",
    "mysql",
    "legacyApi",
    "secrets",
    "console",
    "sandboxController",
    "sandboxTools",
    "quickstart"
  ],
  "additionalProperties": true,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "$ref": "#/definitions/image"
    },
    "deployment": {
      "$ref": "#/definitions/deployment"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "topologySpread": {
      "$ref": "#/definitions/topologySpread"
    },
    "podAntiAffinity": {
      "$ref": "#/definitions/podAntiAffinity"
    },
    "podDisruptionBudget": {
      "$ref": "#/definitions/podDisruptionBudget"
    },
    "autoscaling": {
      "$ref": "#/definitions/autoscaling"
    },
    "config": {
      "type": "object",
      "required": [
        "apiAuthEnabled",
        "realtimeClusterTransport",
        "sandboxEnabled",
        "springAiEnabled"
      ],
      "additionalProperties": true,
      "properties": {
        "apiAuthEnabled": {
          "type": "boolean"
        },
        "realtimeClusterTransport": {
          "type": "string",
          "enum": [
            "redis",
            "local"
          ]
        },
        "javaNetworkPreferIpv4Stack": {
          "type": "boolean"
        },
        "sandboxEnabled": {
          "type": "boolean"
        },
        "sandboxFixedDiagnostic": {
          "type": "boolean"
        },
        "sandboxGeneratedCode": {
          "type": "boolean"
        },
        "sandboxManifestValidation": {
          "type": "boolean"
        },
        "sandboxRemediationSimulation": {
          "type": "boolean"
        },
        "springAiEnabled": {
          "type": "boolean"
        },
        "alertmanagerWebhookAuthMode": {
          "type": "string",
          "enum": [
            "bearer",
            "none"
          ]
        }
      }
    },
    "alertmanager": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "service",
        "route"
      ],
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "service": {
          "type": "object",
          "required": [
            "port"
          ],
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "route": {
          "type": "object",
          "required": [
            "groupWait",
            "groupInterval",
            "repeatInterval"
          ],
          "properties": {
            "groupWait": {
              "type": "string",
              "minLength": 1
            },
            "groupInterval": {
              "type": "string",
              "minLength": 1
            },
            "repeatInterval": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "mysql": {
      "type": "object",
      "required": [
        "enabled",
        "sessionCookieSecure",
        "bootstrapAdminEnabled",
        "migrationJob"
      ],
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "url": {
          "type": "string"
        },
        "sessionCookieSecure": {
          "type": "boolean"
        },
        "bootstrapAdminEnabled": {
          "type": "boolean"
        },
        "bootstrapAdminUsername": {
          "type": "string",
          "maxLength": 128
        },
        "migrationJob": {
          "type": "object",
          "required": [
            "enabled",
            "backoffLimit",
            "activeDeadlineSeconds"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "backoffLimit": {
              "type": "integer",
              "minimum": 0
            },
            "activeDeadlineSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          }
        }
      }
    },
    "dataMigration": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "alarmReadSource": {
          "type": "string",
          "enum": [
            "REDIS",
            "MYSQL",
            "SHADOW"
          ]
        },
        "alarmWriteMode": {
          "type": "string",
          "enum": [
            "REDIS_PRIMARY",
            "DUAL_WRITE",
            "MYSQL_PRIMARY"
          ]
        }
      }
    },
    "legacyApi": {
      "type": "object",
      "required": [
        "enabled",
        "successors",
        "retiredEndpoints"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "successors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^/api/v1/"
          }
        },
        "retiredEndpoints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/api/"
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "required": [
        "create",
        "existingSecret"
      ],
      "additionalProperties": true,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "existingSecret": {
          "$ref": "#/definitions/dnsLabel"
        }
      }
    },
    "console": {
      "type": "object",
      "required": [
        "enabled",
        "replicaCount",
        "image",
        "service",
        "autoscaling"
      ],
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "autoscaling": {
          "$ref": "#/definitions/autoscaling"
        },
        "topologySpread": {
          "$ref": "#/definitions/topologySpread"
        },
        "podAntiAffinity": {
          "$ref": "#/definitions/podAntiAffinity"
        },
        "podDisruptionBudget": {
          "$ref": "#/definitions/podDisruptionBudget"
        },
        "service": {
          "$ref": "#/definitions/service"
        }
      }
    },
    "service": {
      "$ref": "#/definitions/service"
    },
    "ingress": {
      "type": "object",
      "required": [
        "enabled",
        "host",
        "tls"
      ],
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "tls": {
          "type": "object",
          "required": [
            "enabled",
            "secretName"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "$ref": "#/definitions/dnsLabel"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "enabled",
        "extraBackendIngress",
        "extraConsoleIngress"
      ],
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressControllerNamespace": {
          "type": "string"
        },
        "monitoringNamespace": {
          "type": "string"
        },
        "extraBackendIngress": {
          "type": "array"
        },
        "extraConsoleIngress": {
          "type": "array"
        }
      }
    },
    "sandboxController": {
      "type": "object",
      "required": [
        "enabled",
        "namespace",
        "createNamespace",
        "existingSecret",
        "image",
        "quota",
        "networkPolicy"
      ],
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "$ref": "#/definitions/dnsLabel"
        },
        "createNamespace": {
          "type": "boolean"
        },
        "existingSecret": {
          "$ref": "#/definitions/dnsLabel"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "quota": {
          "type": "object",
          "required": [
            "pods"
          ],
          "additionalProperties": true,
          "properties": {
            "pods": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "required": [
            "controllerExtraEgress",
            "jobExtraEgress"
          ],
          "properties": {
            "controllerExtraEgress": {
              "type": "array"
            },
            "jobExtraEgress": {
              "type": "array"
            }
          }
        }
      }
    },
    "sandboxTools": {
      "type": "object",
      "required": [
        "catalog",
        "tools"
      ],
      "properties": {
        "catalog": {
          "type": "object",
          "required": [
            "enabled",
            "mountPath"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "mountPath": {
              "type": "string",
              "pattern": "^/"
            }
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/sandboxTool"
          }
        }
      }
    },
    "quickstart": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  },
  "definitions": {
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "type",
        "port"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "deployment": {
      "type": "object",
      "required": [
        "revisionHistoryLimit",
        "progressDeadlineSeconds",
        "strategy"
      ],
      "properties": {
        "revisionHistoryLimit": {
          "type": "integer",
          "minimum": 1
        },
        "progressDeadlineSeconds": {
          "type": "integer",
          "minimum": 60
        },
        "strategy": {
          "type": "object",
          "required": [
            "maxUnavailable",
            "maxSurge"
          ]
        }
      }
    },
    "topologySpread": {
      "type": "object",
      "required": [
        "enabled",
        "maxSkew",
        "whenUnsatisfiable",
        "topologyKeys"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxSkew": {
          "type": "integer",
          "minimum": 1
        },
        "whenUnsatisfiable": {
          "type": "string",
          "enum": [
            "DoNotSchedule",
            "ScheduleAnyway"
          ]
        },
        "topologyKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "podAntiAffinity": {
      "type": "object",
      "required": [
        "enabled",
        "topologyKey"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "topologyKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": [
        "enabled",
        "maxUnavailable"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas",
        "targetCPUUtilizationPercentage",
        "targetMemoryUtilizationPercentage"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "sandboxTool": {
      "type": "object",
      "required": [
        "id",
        "version",
        "mode",
        "enabled",
        "image",
        "entrypoint",
        "networkEgressPolicy",
        "resources"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/definitions/dnsLabel"
        },
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+$"
        },
        "mode": {
          "type": "string",
          "enum": [
            "FIXED_DIAGNOSTIC",
            "GENERATED_CODE",
            "MANIFEST_VALIDATION",
            "REMEDIATION_SIMULATION"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "required": [
            "repository",
            "digest"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^/"
        },
        "networkEgressPolicy": {
          "type": "string",
          "enum": [
            "DENY_ALL",
            "DNS_AND_ARTIFACT_CHANNEL"
          ]
        },
        "resources": {
          "type": "object",
          "required": [
            "cpu",
            "memory",
            "ephemeralStorage",
            "inputMaxBytes",
            "outputMaxBytes",
            "logMaxBytes",
            "scriptMaxBytes",
            "timeoutSeconds",
            "maxTimeoutSeconds"
          ],
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "minLength": 1
            },
            "ephemeralStorage": {
              "type": "string",
              "minLength": 1
            },
            "inputMaxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 52428800
            },
            "outputMaxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10485760
            },
            "logMaxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2097152
            },
            "scriptMaxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 262144
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 900
            },
            "maxTimeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 900
            }
          }
        }
      }
    }
  }
}
