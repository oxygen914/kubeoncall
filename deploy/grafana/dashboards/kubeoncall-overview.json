{
  "title": "KubeOnCall Overview",
  "uid": "kubeoncall-overview",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"type": "stat", "title": "Alarm executions", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}, "targets": [{"expr": "sum(increase(kubeoncall_alarm_executions_total[1h]))"}]},
    {"type": "stat", "title": "Degraded alarms", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4}, "targets": [{"expr": "sum(increase(kubeoncall_alarm_executions_total{degraded=\"true\"}[1h]))"}]},
    {"type": "stat", "title": "Recovery failures", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4}, "targets": [{"expr": "sum(increase(kubeoncall_alarm_recoveries_total{outcome=\"finalization_failed\"}[1h]))"}]},
    {"type": "stat", "title": "Memory dead letters", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4}, "targets": [{"expr": "sum(increase(kubeoncall_memory_operations_total{operation=\"extract_dead_letter\"}[1h]))"}]},
    {"type": "timeseries", "title": "RAG latency", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8}, "targets": [{"expr": "rate(kubeoncall_rag_latency_ms_sum[5m]) / rate(kubeoncall_rag_latency_ms_count[5m])"}]},
    {"type": "timeseries", "title": "Skill activations", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8}, "targets": [{"expr": "sum by (active) (rate(kubeoncall_skill_activations_total[5m]))"}]},
    {"type": "timeseries", "title": "Mean time to acknowledge", "gridPos": {"x": 0, "y": 12, "w": 8, "h": 8}, "fieldConfig": {"defaults": {"unit": "ms"}}, "targets": [{"expr": "sum by (severity) (rate(kubeoncall_alarm_lifecycle_duration_ms_sum{phase=\"mtta\"}[5m])) / sum by (severity) (rate(kubeoncall_alarm_lifecycle_duration_ms_count{phase=\"mtta\"}[5m]))", "legendFormat": "{{severity}}"}]},
    {"type": "timeseries", "title": "Mean time to recover", "gridPos": {"x": 8, "y": 12, "w": 8, "h": 8}, "fieldConfig": {"defaults": {"unit": "ms"}}, "targets": [{"expr": "sum by (severity) (rate(kubeoncall_alarm_lifecycle_duration_ms_sum{phase=\"mttr\"}[5m])) / sum by (severity) (rate(kubeoncall_alarm_lifecycle_duration_ms_count{phase=\"mttr\"}[5m]))", "legendFormat": "{{severity}}"}]},
    {"type": "timeseries", "title": "Alarm quality outcomes", "gridPos": {"x": 16, "y": 12, "w": 8, "h": 8}, "targets": [{"expr": "sum by (outcome) (rate(kubeoncall_alarm_quality_total[5m]))", "legendFormat": "{{outcome}}"}]},
    {"type": "timeseries", "title": "CI/CD change events", "gridPos": {"x": 0, "y": 20, "w": 12, "h": 7}, "targets": [{"expr": "sum by (source, outcome) (rate(kubeoncall_change_events_total[5m]))", "legendFormat": "{{source}} / {{outcome}}"}]},
    {"type": "timeseries", "title": "HTTP request rate and 5xx", "gridPos": {"x": 12, "y": 20, "w": 12, "h": 7}, "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[5m]))", "legendFormat": "all"}, {"expr": "sum(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\",status=~\"5..\"}[5m]))", "legendFormat": "5xx"}]},
    {"type": "timeseries", "title": "Dependency request outcome", "gridPos": {"x": 0, "y": 27, "w": 12, "h": 7}, "targets": [{"expr": "sum by (dependency, outcome) (rate(kubeoncall_dependency_requests_total[5m]))", "legendFormat": "{{dependency}} / {{outcome}}"}]},
    {"type": "timeseries", "title": "Dependency latency", "gridPos": {"x": 12, "y": 27, "w": 12, "h": 7}, "fieldConfig": {"defaults": {"unit": "ms"}}, "targets": [{"expr": "sum by (dependency, operation) (rate(kubeoncall_dependency_latency_ms_sum[5m])) / sum by (dependency, operation) (rate(kubeoncall_dependency_latency_ms_count[5m]))", "legendFormat": "{{dependency}} / {{operation}}"}]},
    {"type": "timeseries", "title": "Circuit breaker events", "gridPos": {"x": 0, "y": 34, "w": 8, "h": 7}, "targets": [{"expr": "sum by (dependency, event) (increase(kubeoncall_dependency_circuit_total[5m]))", "legendFormat": "{{dependency}} / {{event}}"}]},
    {"type": "timeseries", "title": "Outbox backlog", "gridPos": {"x": 8, "y": 34, "w": 8, "h": 7}, "targets": [{"expr": "kubeoncall_outbox_events", "legendFormat": "{{status}}"}, {"expr": "kubeoncall_outbox_oldest_pending_age_seconds", "legendFormat": "oldest pending age"}]},
    {"type": "timeseries", "title": "Async task backlog", "gridPos": {"x": 16, "y": 34, "w": 8, "h": 7}, "targets": [{"expr": "kubeoncall_async_tasks", "legendFormat": "{{status}}"}, {"expr": "kubeoncall_async_task_oldest_due_age_seconds", "legendFormat": "oldest due age"}]},
    {"type": "timeseries", "title": "JVM heap and live threads", "gridPos": {"x": 0, "y": 41, "w": 12, "h": 7}, "targets": [{"expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "heap used"}, {"expr": "sum(jvm_threads_live_threads)", "legendFormat": "live threads"}]},
    {"type": "timeseries", "title": "Process CPU and file descriptors", "gridPos": {"x": 12, "y": 41, "w": 12, "h": 7}, "targets": [{"expr": "process_cpu_usage", "legendFormat": "CPU"}, {"expr": "process_files_open_files", "legendFormat": "open files"}, {"expr": "process_files_max_files", "legendFormat": "max files"}]},
    {"type": "timeseries", "title": "Database connection pool", "gridPos": {"x": 0, "y": 48, "w": 24, "h": 7}, "targets": [{"expr": "hikaricp_connections_active", "legendFormat": "active"}, {"expr": "hikaricp_connections_idle", "legendFormat": "idle"}, {"expr": "hikaricp_connections_max", "legendFormat": "max"}, {"expr": "hikaricp_connections_pending", "legendFormat": "pending"}]}
  ]
}
