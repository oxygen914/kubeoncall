{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KubeOnCall manifest validation input v1",
  "type": "object",
  "required": ["schemaVersion", "type", "document", "rulesetVersion"],
  "properties": {
    "schemaVersion": {"const": "v1"},
    "type": {"enum": ["MANIFEST", "HELM", "JSON_PATCH", "STRATEGIC_MERGE_PATCH", "RUNBOOK"]},
    "document": {"type": "string", "minLength": 1, "maxLength": 52428800},
    "snapshot": {"type": "string", "maxLength": 52428800},
    "rulesetVersion": {"const": "sandbox-manifest-rules-v1"},
    "preflight": {"type": "object"}
  },
  "additionalProperties": false
}
