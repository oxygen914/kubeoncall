    "cluster": "lab-cluster",
    "alertName": "HostHighCpuUsage",
    "runbookId": "runbook-host-cpu-high",
    "baseline": "lab-default",
    "compareQuery": "100 * (1 - avg by (cluster, instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))"
  }
